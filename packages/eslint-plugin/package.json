{
  "name": "@wiluszdamian/cue-eslint-plugin",
  "version": "1.0.1",
  "description": "ESLint rules generated from the Cue constitution. Works with no agent involved.",
  "license": "MIT",
  "author": "Damian Wilusz",
  "homepage": "https://github.com/wiluszdamian/cue/tree/main/packages/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiluszdamian/cue.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/wiluszdamian/cue/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "node ../../scripts/tsc7.mjs --build tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "node ../../scripts/tsc7.mjs -p tsconfig.json"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.0",
    "@wiluszdamian/cue-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/rule-tester": "^8.70.0",
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
