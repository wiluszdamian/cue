  "private": true,
  "description": "Does Cue actually change what an assistant writes? This measures it.",
  "license": "MIT",
  "author": "Damian Wilusz",
  "homepage": "https://github.com/wiluszdamian/cue/tree/main/packages/benchmark#readme",
  "repository": {
