{
  "name": "@wiluszdamian/cue-mcp",
  "version": "1.0.1",
  "description": "Three point-lookup tools over the Cue rules and knowledge base.",
  "license": "MIT",
  "author": "Damian Wilusz",
  "homepage": "https://github.com/wiluszdamian/cue/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiluszdamian/cue.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/wiluszdamian/cue/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cue-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/tsc7.mjs --build tsconfig.build.json",
    "typecheck": "node ../../scripts/tsc7.mjs -p tsconfig.json",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wiluszdamian/cue-engine": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
