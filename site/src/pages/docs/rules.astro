---
import Docs from '../../layouts/Docs.astro';
---

<Docs slug="rules">
      <div class="table"><table>
        <thead><tr><th>Rule</th><th>Check</th></tr></thead>
        <tbody>
          <tr><td><code>no-hard-waits</code></td><td>enforced</td></tr>
          <tr><td><code>web-first-assertions</code></td><td>enforced</td></tr>
          <tr><td><code>no-raw-selectors</code></td><td>enforced</td></tr>
          <tr><td><code>no-locators-in-tests</code></td><td>enforced</td></tr>
          <tr><td><code>strict-zod-objects</code></td><td>enforced</td></tr>
          <tr><td><code>no-focused-tests</code></td><td>enforced</td></tr>
          <tr><td><code>skips-need-a-reason</code></td><td>enforced</td></tr>
          <tr><td><code>require-test-tags</code></td><td>enforced</td></tr>
          <tr><td><code>no-explicit-any</code></td><td>enforced</td></tr>
          <tr><td><code>no-hardcoded-urls</code></td><td>enforced</td></tr>
          <tr><td><code>selectors-from-agent-kb</code></td><td>review only</td></tr>
        </tbody>
      </table></div>
      <h2 id="rl-example">Example: no-hard-waits</h2>
      <div class="codegroup" data-tabs>
        <div class="tabs" role="tablist">
          <button type="button" role="tab" aria-selected="true">Bad</button>
          <button type="button" role="tab" aria-selected="false">Good</button>
        </div>
        <pre><code>await page.click('#submit');
await page.waitForTimeout(3000);</code></pre>
        <pre hidden><code>await checkout.submit();
await expect(checkout.confirmation).toBeVisible();</code></pre>
      </div>
      <h2 id="rl-change">Changing a rule</h2>
      <p>Rules live in one YAML file. Edit it and regenerate; the ESLint rules, the docs and the agent instructions update together.</p>
    
</Docs>
